<UserControl x:Class="FASTIMATE.IzvozDokumentacijeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="540" d:DesignWidth="740"
             Background="Transparent" FontFamily="Segoe UI" FontSize="14">

    <UserControl.Resources>
        <Style x:Key="RoundedButtonStyleBase" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,25,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel Margin="30,45,30,30" HorizontalAlignment="Stretch">
            <!-- Naslov -->
            <TextBlock Text="IZVOZ DOKUMENTACIJE" FontSize="22" FontWeight="Bold" Foreground="#00BCD4" Margin="0,0,0,25"/>

            <!-- Pripremni direktorij -->
            <StackPanel Margin="0,0,0,25" HorizontalAlignment="Stretch">
                <TextBlock Text="Pripremni direktorij (Root projekta)" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" FontSize="14"/>
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="txtPutanja" Height="40" Padding="10,8" Background="#2C2C2C"
                                 Foreground="White" BorderBrush="#444" FontSize="13" TextChanged="txtPutanja_TextChanged"/>
                        <TextBlock x:Name="lblPutanjaPlaceholder" Text="Odaberi lokaciju..." Foreground="#888888" FontSize="13"
                                   FontStyle="Italic" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="1" Content="..." Width="60" Height="40" Margin="10,0,0,0"
                            Background="#4CAF50" Foreground="White" BorderBrush="#4CAF50"
                            Style="{StaticResource RoundedButtonStyleBase}" Click="btnOdabrati_Click"/>
                </Grid>
            </StackPanel>

            <!-- Odabir tipova izvoza -->
            <Border Background="#2C2C2C" CornerRadius="10" Padding="20,18" Margin="0,0,0,30" BorderBrush="#333" BorderThickness="1" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Tipovi dokumenata za izvoz:" FontWeight="Bold" Foreground="#AAA" Margin="0,0,0,14" FontSize="13"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="chkPdf" Content="PDF crteži" IsChecked="True" Checked="IndividualCheckBox_Changed" Unchecked="IndividualCheckBox_Changed"/>
                        <CheckBox x:Name="chkDxf" Content="DXF fajlovi" IsChecked="True" Checked="IndividualCheckBox_Changed" Unchecked="IndividualCheckBox_Changed"/>
                        <CheckBox x:Name="chkStep" Content="STEP modeli" IsChecked="True" Checked="IndividualCheckBox_Changed" Unchecked="IndividualCheckBox_Changed"/>
                        <CheckBox x:Name="chkSve" Content="SVE" IsChecked="True" Checked="chkSve_Checked" Unchecked="chkSve_Unchecked"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Dugme POKRENI IZVOZ -->
            <Button x:Name="btnStartExport" Content="POKRENI IZVOZ" Width="200" Height="48" HorizontalAlignment="Right"
                    Background="#00BCD4" Foreground="White" BorderBrush="#00BCD4" FontSize="15" FontWeight="Bold"
                    Style="{StaticResource RoundedButtonStyleBase}" Click="btnStartExport_Click"/>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid x:Name="loadingOverlay" Background="#CC1E1E1E" Visibility="Collapsed">
            <Border Background="#2C2C2C" CornerRadius="10" Padding="40,30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#00BCD4" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="300" Height="14" Margin="0,0,0,15" Foreground="#00BCD4"/>
                    <TextBlock x:Name="lblLoadingStatus" Text="Izvoz dokumentacije u toku... Molimo sačekajte." Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
