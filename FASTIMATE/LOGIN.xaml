<Window x:Class="FASTIMATE.LOGIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LOGIN"
        Icon="app_icon.ico"
        Height="350" Width="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="8,4,8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#388E3C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource LoginButtonStyle}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="BorderBrush" Value="#B71C1C"/>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1E" CornerRadius="15" Padding="20" Margin="10" Effect="{StaticResource DropShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Naslov sa logom i tekstom -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Image Source="/login_logo.png" Width="48" Height="48" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="F A S T I M A T E"
                           Foreground="White"            
                           FontSize="28"
                           VerticalAlignment="Center" FontStyle="Italic" FontFamily="Stencil"/>
            </StackPanel>

            <!-- Forma -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Korisničko ime -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Korisničko ime" Foreground="White" Width="110" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox x:Name="txtUsername" Width="240" Height="34" Style="{StaticResource InputTextBoxStyle}" KeyDown="txtUsername_KeyDown"/>
                </StackPanel>

                <!-- Lozinka -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Lozinka" Foreground="White" Width="110" VerticalAlignment="Center" FontSize="14"/>
                    <PasswordBox x:Name="txtPasw" Width="240" Height="34" KeyDown="txtPasw_KeyDown"
                                 Background="#2C2C2C" Foreground="White" BorderBrush="#444" Padding="8,4,8,4" VerticalContentAlignment="Center" FontSize="14"/>
                </StackPanel>

                <!-- Poruka o grešci -->
                <TextBlock x:Name="lblError" Foreground="#FF5252" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                <!-- Dugmad -->
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
                    <Button x:Name="btnSnimit" Content="PRIJAVI SE" Width="101" Height="35" Margin="0,0,10,0" Click="btnSnimit_Click" KeyDown="btnSnimit_KeyDown"
                Style="{StaticResource LoginButtonStyle}"/>
                    <Button x:Name="btnOdustati" Content="ODUSTANI" Width="100" Height="35" Click="btnOdustati_Click"
                Style="{StaticResource CancelButtonStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Copyright -->
            <TextBlock Text="© 2026 Dino Bratić. Sva prava zadržana."
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,10,2" Foreground="#555555" FontSize="10" Grid.Row="1"/>
        </Grid>
    </Border>
</Window>