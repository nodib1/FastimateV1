<UserControl x:Class="FASTIMATE.UvozSablonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="740"
             Background="Transparent" FontFamily="Segoe UI" FontSize="14">

    <UserControl.Resources>
        <Style x:Key="RoundedButtonStyleBase" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stilizovani Tamni ComboBox Predložak sa podrškom za IsEditable -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid x:Name="MainGrid">
                <ToggleButton x:Name="ToggleButton"
                              Background="#252525"
                              Foreground="White"
                              BorderBrush="#555"
                              BorderThickness="1"
                              Focusable="False"
                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border"
                                    Background="#252525"
                                    BorderBrush="#555"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="White"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#333333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <TextBox x:Name="PART_EditableTextBox"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Center"
                         Margin="10,3,25,3"
                         Focusable="True"
                         Background="Transparent"
                         Foreground="White"
                         BorderThickness="0"
                         IsReadOnly="{TemplateBinding IsReadOnly}"
                         Visibility="Hidden"/>

                <ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="10,3,23,3"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>

                <Popup x:Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Grid x:Name="DropDown"
                          SnapsToDevicePixels="True"
                          MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder"
                                Background="#1E1E1E"
                                BorderThickness="1"
                                BorderBrush="#555"
                                CornerRadius="4"/>
                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEditable" Value="True">
                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Stilizovano Tamno Zaglavlje Tabele -->
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="#37474F"/>
            <Setter Property="Foreground" Value="#00BCD4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#455A64"/>
        </Style>

        <!-- RepeatButton style za strijelce skrolera -->
        <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Moderan Tamni ScrollBar (Vertikalni i Horizontalni) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="#1E1E1E" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder" Background="#424242" CornerRadius="4" Margin="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#00BCD4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#00ACC1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="#1E1E1E" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" IsEnabled="{TemplateBinding IsMouseOver}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageLeftCommand}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="ThumbBorder" Background="#424242" CornerRadius="4" Margin="2"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#00BCD4"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#00ACC1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageRightCommand}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,30,30,30" MaxWidth="660">
                <!-- Naslov -->
                <TextBlock Text="IMPORT" FontSize="22" FontWeight="Bold" Foreground="#FFB74D" Margin="0,0,0,25"/>

                <!-- Status Kartica Šablona -->
                <Border Background="#2C2C2C" CornerRadius="10" Padding="20,16" Margin="0,0,0,20" BorderBrush="#444" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TRENUTNI AKTIVNI ŠABLON" FontWeight="Bold" Foreground="#AAA" Margin="0,0,0,8" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Status: " Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblStatusText" Text="Fabrički ugrađeni šablon" Foreground="#81C784" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock x:Name="lblInfo" Text="Svi obračuni tekuće ponude/tehnologije koriste podrazumijevanu strukturu tabele."
                                   Foreground="#B0BEC5" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Akcije Šablona -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                    <Button x:Name="btnUvezi" Content="UVEZI NOVI ŠABLON (.xlsx)" Height="42" Margin="0,0,12,0" Width="260"
                            Background="#FFB74D" Foreground="Black" BorderBrush="#FFB74D" FontSize="13" FontWeight="Bold"
                            Style="{StaticResource RoundedButtonStyleBase}" Click="btnUvezi_Click"/>

                    <Button x:Name="btnVratiFabricki" Content="VRATI FABRIČKI ŠABLON" Height="42" Width="220"
                            Background="#37474F" Foreground="White" BorderBrush="#546E7A" FontSize="13" FontWeight="SemiBold"
                            Style="{StaticResource RoundedButtonStyleBase}" Click="btnVratiFabricki_Click"/>
                </StackPanel>

                <!-- ERP Vijčana Roba Kartica sa Pregledom i Direktnom Izmjenom -->
                <Border Background="#2C2C2C" CornerRadius="10" Padding="20,16" Margin="0,0,0,20" BorderBrush="#00BCD4" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ERP BAZA VIJČANE ROBE (DIN / ISO STANDARDI)" FontWeight="Bold" Foreground="#00BCD4" Margin="0,0,0,8" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Učitano identa: " Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblErpCount" Text="0 identa u bazi" Foreground="#4FC3F7" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Pretraga po DIN, ISO, Schraube, Vijak, Matica, Bolt. (Podaci u tabeli su direktno izmjenjivi)"
                                   Foreground="#B0BEC5" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Interaktivna Tabela Baze s ugrađenim tamnim skrolerima i izmjenom -->
                        <ListView x:Name="lvErpFasteners" Height="180" Background="#1E1E1E" Foreground="White" BorderBrush="#444" BorderThickness="1"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2E3B42"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#37474F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ERP IDENT" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ErpIdent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="NAZIV / OPIS ARTIKLA" Width="260">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Naziv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" BorderThickness="0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="STANDARDI" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Standard, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" BorderThickness="0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="DIMENZIJA" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Velicina, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" BorderThickness="0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Akcije za ERP Bazu -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                    <Button x:Name="btnUveziErp" Content="UVEZI TABELU (.xlsx / .csv)" Height="42" Width="230" Margin="0,0,10,0"
                            Background="#00ACC1" Foreground="White" BorderBrush="#00ACC1" FontSize="13" FontWeight="Bold"
                            Style="{StaticResource RoundedButtonStyleBase}" Click="btnUveziErp_Click"/>

                    <Button x:Name="btnSacuvajErp" Content="SAČUVAJ IZMJENE" Height="42" Width="170" Margin="0,0,10,0"
                            Background="#2E7D32" Foreground="White" BorderBrush="#2E7D32" FontSize="13" FontWeight="Bold"
                            Style="{StaticResource RoundedButtonStyleBase}" Click="btnSacuvajErp_Click"/>

                    <Button x:Name="btnObrisiErp" Content="OBRIŠI BAZU" Height="42" Width="130"
                            Background="#C62828" Foreground="White" BorderBrush="#B71C1C" FontSize="13" FontWeight="Bold"
                            Style="{StaticResource RoundedButtonStyleBase}" Click="btnObrisiErp_Click"/>
                </StackPanel>

                <!-- BAZA SIROVINA LIMOVA (Pregled, Uvoz, Izmjena) -->
                <Border Background="#2C2C2C" CornerRadius="10" Padding="20,16" Margin="0,0,0,20" BorderBrush="#81C784" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="BAZA SIROVINA LIMOVA (ERP IDENTI LIMOVA ZA PONUDE)" FontWeight="Bold" Foreground="#81C784" Margin="0,0,0,8" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Učitano sirovina: " Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblSmCount" Text="0 identa u bazi" Foreground="#A5D6A7" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Pregled i uvoz sirovina limova iz ERP sistema za ponude i sumiranje mase prema materijalu i debljini."
                                   Foreground="#B0BEC5" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Tabela Sirovina Limova -->
                        <ListView x:Name="lvSheetMetal" Height="180" Background="#1E1E1E" Foreground="White" BorderBrush="#444" BorderThickness="1" Margin="0,0,0,14"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2E3B42"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#37474F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ERP IDENT" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ErpIdent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="MATERIJAL" Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Material, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" BorderThickness="0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="DEBLJINA (mm)" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ThicknessStr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" BorderThickness="0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="OPIS SIROVINE / FORMAT" Width="250">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" BorderThickness="0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Forma za ručno dodavanje sirovine limova -->
                        <TextBlock Text="Dodaj novu sirovinu lima u bazu:" FontWeight="Bold" Foreground="#AAA" Margin="0,0,0,8" FontSize="12"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ERP Ident" Foreground="#AAA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Materijal (Lim)" Foreground="#AAA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Debljina (mm)" Foreground="#AAA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Opis Sirovine" Foreground="#AAA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>

                            <TextBox x:Name="txtNewSmIdent" Grid.Row="1" Grid.Column="0" Height="36" Margin="0,0,6,0" Background="#252525" Foreground="White"
                                     BorderBrush="#555" Padding="6,4" VerticalContentAlignment="Center" MaxLength="6"
                                     PreviewTextInput="txtNewSmIdent_PreviewTextInput"
                                     ToolTip="ERP Ident sirovine (brojčana vrijednost od 6 cifara npr. 900123)"/>

                            <ComboBox x:Name="cmbNewSmMaterial" Grid.Row="1" Grid.Column="1" Height="36" Margin="0,0,6,0" SelectedIndex="0"
                                      IsEditable="True" Template="{StaticResource DarkComboBoxTemplate}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#252525"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBoxItem Content="Crni lim"/>
                                <ComboBoxItem Content="Inox"/>
                                <ComboBoxItem Content="Pocinčani"/>
                                <ComboBoxItem Content="Aluminijum"/>
                            </ComboBox>

                            <TextBox x:Name="txtNewSmThickness" Grid.Row="1" Grid.Column="2" Height="36" Margin="0,0,6,0" Background="#252525" Foreground="White"
                                     BorderBrush="#555" Padding="6,4" VerticalContentAlignment="Center" 
                                     PreviewTextInput="txtNewSmThickness_PreviewTextInput"
                                     ToolTip="Npr. 2.0 ili 2,0"/>

                            <TextBox x:Name="txtNewSmDesc" Grid.Row="1" Grid.Column="3" Height="36" Margin="0,0,6,0" Background="#252525" Foreground="White"
                                     BorderBrush="#555" Padding="6,4" VerticalContentAlignment="Center" ToolTip="Npr. Lim S235JR 2mm 1500x3000"/>

                            <Button x:Name="btnDodajSheetMetal" Grid.Row="1" Grid.Column="4" Content="+ DODAJ" Height="36"
                                    Background="#2E7D32" Foreground="White" BorderBrush="#388E3C" FontSize="12" FontWeight="Bold"
                                    Style="{StaticResource RoundedButtonStyleBase}" Click="btnDodajSheetMetal_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Akcije za Bazu Sirovina Limova -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                    <Button x:Name="btnUveziSheetMetal" Content="UVEZI SIROVINE (.xlsx / .csv)" Height="42" Width="230" Margin="0,0,10,0"
                            Background="#4CAF50" Foreground="White" BorderBrush="#4CAF50" FontSize="13" FontWeight="Bold"
                            Style="{StaticResource RoundedButtonStyleBase}" Click="btnUveziSheetMetal_Click"/>

                    <Button x:Name="btnSacuvajSheetMetal" Content="SAČUVAJ SIROVINE" Height="42" Width="170" Margin="0,0,10,0"
                            Background="#2E7D32" Foreground="White" BorderBrush="#2E7D32" FontSize="13" FontWeight="Bold"
                            Style="{StaticResource RoundedButtonStyleBase}" Click="btnSacuvajSheetMetal_Click"/>

                    <Button x:Name="btnObrisiSheetMetal" Content="OBRIŠI BAZU" Height="42" Width="130"
                            Background="#C62828" Foreground="White" BorderBrush="#B71C1C" FontSize="13" FontWeight="Bold"
                            Style="{StaticResource RoundedButtonStyleBase}" Click="btnObrisiSheetMetal_Click"/>
                </StackPanel>

                <!-- K-FAKTOR KARTICA (Pregled, Dodavanje i Izmjena) -->
                <Border Background="#2C2C2C" CornerRadius="10" Padding="20,16" Margin="0,0,0,15" BorderBrush="#FF9800" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="PRAVILA K-FAKTORA (SAVIJANJE LIMA)" FontWeight="Bold" Foreground="#FF9800" Margin="0,0,0,8" FontSize="12"/>
                        <TextBlock Text="Pravila za validaciju K-faktora prema debljini i materijalu u SolidWorks-u."
                                   Foreground="#B0BEC5" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Tabela K-Faktora -->
                        <ListView x:Name="lvKFactors" Height="170" Background="#1E1E1E" Foreground="White" BorderBrush="#444" BorderThickness="1" Margin="0,0,0,14"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2E3B42"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#37474F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="MATERIJAL" Width="160">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Material, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Normal"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="DEBLJINA (mm)" Width="160">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ThicknessStr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Normal"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="K-FAKTOR" Width="160">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding KFactorStr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Normal"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Forma za dodavanje novog K-Faktora sa jasnim natpisima -->
                        <TextBlock Text="Dodaj novi K-Faktor u bazu:" FontWeight="Bold" Foreground="#AAA" Margin="0,0,0,8" FontSize="12"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Materijal" Foreground="#AAA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Debljina (mm)" Foreground="#AAA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="K-Faktor" Foreground="#AAA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>

                            <ComboBox x:Name="cmbNewMaterial" Grid.Row="1" Grid.Column="0" Height="36" Margin="0,0,8,0" SelectedIndex="0"
                                      Template="{StaticResource DarkComboBoxTemplate}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#252525"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBoxItem Content="Čelik"/>
                                <ComboBoxItem Content="Inox"/>
                                <ComboBoxItem Content="Aluminijum"/>
                            </ComboBox>

                            <TextBox x:Name="txtNewThickness" Grid.Row="1" Grid.Column="1" Height="36" Margin="0,0,8,0" Background="#252525" Foreground="White"
                                     BorderBrush="#555" Padding="8,6" VerticalContentAlignment="Center" ToolTip="Unesite debljinu u mm (npr. 1,5 ili 1.5)"/>

                            <TextBox x:Name="txtNewKFactor" Grid.Row="1" Grid.Column="2" Height="36" Margin="0,0,8,0" Background="#252525" Foreground="White"
                                     BorderBrush="#555" Padding="8,6" VerticalContentAlignment="Center" ToolTip="Unesite K-Faktor (npr. 0,22 ili 0.22)"/>

                            <Button x:Name="btnDodajKFactor" Grid.Row="1" Grid.Column="3" Content="+ DODAJ K-FAKTOR" Height="36"
                                    Background="#E65100" Foreground="White" BorderBrush="#EF6C00" FontSize="12" FontWeight="Bold"
                                    Style="{StaticResource RoundedButtonStyleBase}" Click="btnDodajKFactor_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Akcije za K-Faktore -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnSacuvajKFactors" Content="SAČUVAJ K-FAKTORE" Height="42" Width="200" Margin="0,0,10,0"
                            Background="#2E7D32" Foreground="White" BorderBrush="#2E7D32" FontSize="13" FontWeight="Bold"
                            Style="{StaticResource RoundedButtonStyleBase}" Click="btnSacuvajKFactors_Click"/>

                    <Button x:Name="btnObrisiKFactor" Content="OBRIŠI SELEKTOVANI" Height="42" Width="180"
                            Background="#C62828" Foreground="White" BorderBrush="#B71C1C" FontSize="13" FontWeight="Bold"
                            Style="{StaticResource RoundedButtonStyleBase}" Click="btnObrisiKFactor_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
