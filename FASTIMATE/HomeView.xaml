<UserControl x:Class="FASTIMATE.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" FontFamily="Segoe UI" FontSize="14">

    <UserControl.Resources>
        <!-- Stilovi dugmadi -->
        <Style x:Key="RoundedButtonStyleBase" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="YellowButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyleBase}">
            <Setter Property="Background" Value="#FFF59D"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#FFF59D"/>
        </Style>

        <Style x:Key="PurpleButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyleBase}">
            <Setter Property="Background" Value="#E1BEE7"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E1BEE7"/>
        </Style>

        <Style x:Key="GreenButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyleBase}">
            <Setter Property="Background" Value="#A5D6A7"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#A5D6A7"/>
        </Style>

        <Style x:Key="OrangeButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyleBase}">
            <Setter Property="Background" Value="#FFB74D"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#FFB74D"/>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <StackPanel Margin="30,20,30,20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <!-- Red dugmadi (Rašireni po čitavoj širini panela) -->
            <Grid Margin="0,0,0,30" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="btnOsvjezi" Content="Osvježi" Height="52" Style="{StaticResource YellowButtonStyle}" Margin="0,0,10,0" FontSize="15" FontWeight="Bold" Click="btnOsvjezi_Click"/>
                <Button Grid.Column="1" x:Name="btnPonuda" Content="Ponuda" Height="52" Style="{StaticResource PurpleButtonStyle}" Margin="5,0,5,0" FontSize="15" FontWeight="Bold" Click="btnPonuda_Click"/>
                <Button Grid.Column="2" x:Name="btnTehnologija" Content="Tehnologija" Height="52" Style="{StaticResource GreenButtonStyle}" Margin="10,0,0,0" FontSize="15" FontWeight="Bold" Click="btnTehnologija_Click"/>
            </Grid>

            <StackPanel Margin="0,0,0,25" Height="65">
                <TextBlock Text="IDENT" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" FontSize="14"/>
                <TextBox x:Name="txtIdent" Height="34" Padding="6" Width="160" Background="#2C2C2C"
            		Foreground="White" BorderBrush="#444" HorizontalAlignment="Left" MaxLength="6" PreviewTextInput="txtIdent_PreviewTextInput" />
            </StackPanel>

            <!-- Pripremni direktorij -->
            <StackPanel Margin="0,0,0,30" HorizontalAlignment="Stretch">
                <TextBlock Text="Pripremni direktorij" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" FontSize="14"/>
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtPutanja" Height="42" Padding="10,8" Background="#2C2C2C"
                             Foreground="White" BorderBrush="#444" FontSize="13"/>
                    <Button Grid.Column="1" Content="..." Width="65" Height="42" Margin="10,0,0,0"
                            Background="#4CAF50" Foreground="White" BorderBrush="#4CAF50" Style="{StaticResource RoundedButtonStyleBase}" Click="btnOdabrati_Click"/>
                </Grid>
            </StackPanel>

            <!-- Akciona dugmad -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="btnStart" Content="POKRENUTI" Width="180" Height="48"
                        Background="#2196F3" Foreground="White" BorderBrush="#2196F3" FontSize="15" FontWeight="Bold"
                        Style="{StaticResource RoundedButtonStyleBase}" Click="btnStart_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Loading Overlay sa indikatorom napretka -->
        <Grid x:Name="loadingOverlay" Background="#CC1E1E1E" Visibility="Collapsed">
            <Border Background="#2C2C2C" CornerRadius="10" Padding="30,20" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#2196F3" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="260" Height="14" Margin="0,0,0,15" Foreground="#2196F3"/>
                    <TextBlock x:Name="lblLoadingStatus" Text="Obračun u toku... Molimo sačekajte." Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>