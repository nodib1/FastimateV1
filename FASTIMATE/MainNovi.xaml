<Window x:Class="FASTIMATE.MainNovi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FASTIMATE"
        Icon="app_icon.ico"
        Height="560" Width="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>
        <!-- Senka -->
        <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>

        <!-- Stil za dugmad u meniju -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stil za dugme Odjava -->
        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="BorderBrush" Value="#E53935"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Margin" Value="10,10,10,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E53935"/>
                    <Setter Property="BorderBrush" Value="#FF6B6B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        

        <!-- Sidebar dugme (Neaktivno stanje - Nježno plavkasto/tamno) -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252830"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Margin" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Hover -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E3A5F"/>
                    <Setter Property="Foreground" Value="#38BDF8"/>
                    <Setter Property="BorderBrush" Value="#0288D1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar dugme kada je AKTIVNO / FOKUSIRANO (Prelijepa plava boja) -->
        <Style x:Key="SidebarActiveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0288D1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Margin" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#039BE5"/>
                    <Setter Property="BorderBrush" Value="#7DD3FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Glavni Border sa zaobljenim uglovima -->
    <Border Background="#1E1E1E" CornerRadius="15" Padding="0" ClipToBounds="True" Margin="10"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Effect="{StaticResource DropShadowEffect}" MouseDown="Window_MouseDown">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <!-- širi sidebar -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#2C2C2C" CornerRadius="15,0,0,15">
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,12,8,12" Width="190" Height="50">
                            <Image Source="/app_logo.png" Width="48" Height="48" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <Button Content="FASTIMATE"
                                    Click="BtnFastimate_Click"
                                    Foreground="White"
                                    FontSize="18"
                                    Margin="0,5,0,0"
                                    Width="120"
                                    FontFamily="Stencil"
                                    FontStyle="Italic"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Cursor="Hand"/>
                        </StackPanel>


                        <!-- Novi meni dugmići sa aktivnim posivljenim stanjem -->
                        <Button x:Name="btnHome" Content="Home" 
                                Style="{StaticResource SidebarActiveButtonStyle}" 
                                Click="BtnHome_Click"/>

                        <Button x:Name="btnIzvozDokumentacije" Content="Izvoz dokumentacije" 
                                Style="{StaticResource SidebarButtonStyle}" 
                                Click="BtnIzvozDokumentacije_Click"/>

                        <Button x:Name="btnUvozSablon" Content="Import" 
                                Style="{StaticResource SidebarButtonStyle}" 
                                Click="BtnUvozSablon_Click"/>

                        <Button x:Name="btnLicenca" Content="Licenca" 
                                Style="{StaticResource SidebarButtonStyle}" 
                                Click="BtnLicenca_Click"/>

                        <Button x:Name="btnPomoc" Content="Pomoć" 
                                Style="{StaticResource SidebarButtonStyle}" 
                                Click="BtnPomoc_Click"/>
                    </StackPanel>

                    <Button Content="Odjava" Click="BtnOdjava_Click"
                            Style="{StaticResource LogoutButtonStyle}" 
                            VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Height="44" Width="180" Margin="10,0,10,15"/>
                </Grid>
            </Border>

            <!-- Glavni sadržaj sa zaobljenim uglovima sa desne strane -->
            <Border Grid.Column="1" CornerRadius="0,15,15,0" ClipToBounds="True" Background="#1E1E1E">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Zaglavlje (Top Bar za korisnika) -->
                    <DockPanel Grid.Row="0" Margin="15,12,20,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <TextBlock Text="Logovani korisnik: " Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="labelkorisnik" Text="Dino Bratić"
                                       FontStyle="Italic" Foreground="#90CAF9" FontWeight="Normal" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Glavni Sadržaj (Sredina - sa omogućenim skrolovanjem bez preklapanja) -->
                    <ContentControl Grid.Row="1" x:Name="MainContent" Margin="0"/>

                    <!-- Podnožje (Bottom Footer Bar za Copyright) -->
                    <DockPanel Grid.Row="2" Margin="15,4,20,10">
                        <TextBlock Text="© 2026 Dino Bratić. Sva prava zadržana."
                                   HorizontalAlignment="Right" DockPanel.Dock="Right"
                                   Foreground="#666666" FontSize="11" FontWeight="Normal"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
