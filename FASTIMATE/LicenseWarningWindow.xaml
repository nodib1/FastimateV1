<Window x:Class="FASTIMATE.LicenseWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upozorenje - Licenca" 
        Height="270" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Border Background="#1E1E1E" BorderBrush="#FFB74D" BorderThickness="2" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Naslovni Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="⚠️ " FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Upozorenje - Licenca" FontSize="16" FontWeight="Bold" Foreground="#FFB74D" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Width="28" Height="28"
                        Background="Transparent" Foreground="#AAA" BorderThickness="0"
                        FontSize="14" FontWeight="Bold" Cursor="Hand" Click="btnClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FFF"/>
                                    <Setter Property="Background" Value="#333333"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Sadržaj Poruke -->
            <Grid Grid.Row="1" Margin="0,5,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25" Background="#332A00" BorderBrush="#FFB74D" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,0,15,0">
                    <TextBlock Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="UPOZORENJE O ISTEKU LICENCE!" FontSize="14" FontWeight="Bold" Foreground="#FFB74D" Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtWarningDetail" Text="Vaša FASTIMATE licenca ističe uskoro." FontSize="13" Foreground="#E0E0E0" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="18"/>
                    <TextBlock Text="Molimo obratite se administratoru radi pravovremenog produženja." FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Dugme U REDU -->
            <Grid Grid.Row="2">
                <Button Content="U REDU" Width="140" Height="36" HorizontalAlignment="Right"
                        Background="#FFB74D" Foreground="#1E1E1E" FontWeight="Bold" FontSize="13"
                        BorderThickness="0" Cursor="Hand" Click="btnOk_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFA726"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
