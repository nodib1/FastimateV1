<Window x:Class="FASTIMATE.FasterpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FASTIMATE"
        Title="FastERP"
        Icon="app_icon.ico"
        Height="760" Width="1280" MinHeight="500" MinWidth="900"
        ResizeMode="CanResize" WindowStyle="None"
        StateChanged="Window_StateChanged"
        WindowStartupLocation="Manual"
        Background="#1E1E1E"
        FontFamily="Segoe UI" FontSize="13">

    <!-- Vlastiti okvir: povlačenje za zaglavlje, promjena veličine za ivice -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Dugmad u zaglavlju (minimiziraj / maksimiziraj / crveni X) -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0288D1"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FButtonGreen" TargetType="Button" BasedOn="{StaticResource FButton}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="BorderBrush" Value="#66BB6A"/>
        </Style>
        <Style x:Key="FButtonGray" TargetType="Button" BasedOn="{StaticResource FButton}">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <!-- Tabele -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="RowBackground" Value="#2C2C2C"/>
            <Setter Property="AlternatingRowBackground" Value="#262626"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3F3F46"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3F3F46"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="26"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A5F"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Bojenje redova po statusu (legenda) -->
        <Style x:Key="StatusRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:FasterpStatus.Novi}">
                    <Setter Property="Background" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:FasterpStatus.Izbrisan}">
                    <Setter Property="Background" Value="#B71C1C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:FasterpStatus.Promijenjen}">
                    <Setter Property="Background" Value="#E67E00"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Stablo -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <EventSetter Event="Selected" Handler="TreeItem_Selected"/>
        </Style>
    </Window.Resources>

    <Border x:Name="rootBorder" BorderBrush="#3F3F46" BorderThickness="1">
    <Grid Margin="14,10,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Zaglavlje: naslov, Osvježi, dugmad prozora (povlačenjem zaglavlja se pomjera prozor) -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False" Height="46">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Image Source="/app_logo.png" Width="38" Height="38" Margin="0,0,10,0"/>
                <TextBlock Text="FastERP" Foreground="White" FontSize="26" FontWeight="Black" FontStyle="Italic"
                           VerticalAlignment="Center" Margin="0,0,24,0"/>
                <Button x:Name="btnOsvjezi" Content="⟳  Osvježi" Style="{StaticResource FButtonGreen}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="BtnOsvjezi_Click" ToolTip="Ponovo učitaj sve podatke iz SolidWorksa i zadrži isti odabir"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                <Button Content="—" Style="{StaticResource CaptionButton}" ToolTip="Minimiziraj" Click="BtnMinimiziraj_Click"/>
                <Button x:Name="btnMaksimiziraj" Content="☐" Style="{StaticResource CaptionButton}" ToolTip="Maksimiziraj" Click="BtnMaksimiziraj_Click"/>
                <Button Content="✕" Style="{StaticResource CloseButton}" ToolTip="Zatvori" Click="BtnZatvori_Click"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" x:Name="lblKorisnik" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lijevo: stablo SolidWorks -->
            <!-- Glavni panel: svjetlija nijansa i plavi okvir -->
            <Border Grid.Column="0" Background="#323A48" BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Stablo SolidWorks" Style="{StaticResource SectionTitle}" FontSize="17" Foreground="White" Margin="10,10,10,8"/>
                    <!-- Pretraga stabla -->
                    <Grid DockPanel.Dock="Top" Margin="10,0,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtPretraga" Grid.Column="0" Height="30" Padding="6,4" VerticalContentAlignment="Center"
                                 Background="#252B36" Foreground="White" BorderBrush="#5B6577" CaretBrush="White"
                                 KeyDown="TxtPretraga_KeyDown" ToolTip="Ident, oznaka ili naziv iz SolidWorksa (Enter = sljedeći)"/>
                        <TextBlock Grid.Column="0" Text="Pretraga (ident, oznaka, naziv)..." Foreground="#6B7280" FontStyle="Italic"
                                   Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtPretraga}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Content="Traži" Style="{StaticResource FButtonGray}" Height="30" Margin="6,0,0,0" Click="BtnTrazi_Click"/>
                    </Grid>
                    <TreeView x:Name="treeSolid" Background="Transparent" BorderThickness="0" Padding="6,4" FontSize="14"
                              SelectedItemChanged="TreeSolid_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:FasterpNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Foreground="#FBBF24" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DisplayName}"/>                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Desno: SolidWorks info / akcije / ERP info -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Selektovani sklop/dio iz stabla -->
                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock Text="Selektovano u stablu" Style="{StaticResource SectionTitle}" FontSize="17" Foreground="White"/>
                </DockPanel>
                <!-- Naglašena tabela: podaci o onome što je kliknuto u stablu -->
                <Border Grid.Row="1" Margin="0,0,0,14" BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="6" Background="#1E3A5F">
                    <DataGrid x:Name="gridOdabrano" VerticalScrollBarVisibility="Disabled" BorderThickness="0"
                              FontSize="15" FontWeight="SemiBold" RowHeight="38"
                              Foreground="White" RowBackground="#1E3A5F" AlternatingRowBackground="#1E3A5F" Background="#1E3A5F">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Background" Value="#0288D1"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="6,7"/>
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                    </DataGrid>
                </Border>

                <DockPanel Grid.Row="2" Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock Text="SolidWorks info" Style="{StaticResource SectionTitle}"/>
                    <Button DockPanel.Dock="Right" x:Name="btnIzmjenaSolid" Content="Izmjena podataka (SolidWorks)"
                            Style="{StaticResource FButton}" Margin="0" Click="BtnIzmjenaSolid_Click"
                            ToolTip="Upiši izmjene iz gornje tabele u custom properties u SolidWorksu"/>
                    <CheckBox DockPanel.Dock="Right" x:Name="chkSkrivene" Content="Prikaži skrivene kolone" Foreground="#D1D5DB"
                              VerticalAlignment="Center" Margin="0,0,16,0" Checked="ChkSkrivene_Changed" Unchecked="ChkSkrivene_Changed"/>
                </DockPanel>

                <DataGrid Grid.Row="3" x:Name="gridSolid" RowStyle="{StaticResource StatusRowStyle}"/>

                <!-- Akcije i legenda -->
                <Border Grid.Row="4" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Margin="0,10" Padding="10,8">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="⇄  Uporedi SolidWorks i ERP" Style="{StaticResource FButtonGray}" Click="BtnUporedi_Click"/>
                        <Button DockPanel.Dock="Left" Content="⬇  Kopiraj iz SolidWorks u ERP" Style="{StaticResource FButton}" Click="BtnKopirajUErp_Click"/>
                        <Button DockPanel.Dock="Left" Content="⬆  Kopiraj iz ERP u SolidWorks" Style="{StaticResource FButton}" Click="BtnKopirajUSolid_Click"/>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Legenda:" Foreground="#9CA3AF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Border Width="14" Height="14" Background="#2E7D32" Margin="0,0,4,0"/>
                            <TextBlock Text="Novi ident" Foreground="#D1D5DB" Margin="0,0,12,0"/>
                            <Border Width="14" Height="14" Background="#B71C1C" Margin="0,0,4,0"/>
                            <TextBlock Text="Izbrisani ident" Foreground="#D1D5DB" Margin="0,0,12,0"/>
                            <Border Width="14" Height="14" Background="#E67E00" Margin="0,0,4,0"/>
                            <TextBlock Text="Promijenjeni ident" Foreground="#D1D5DB" Margin="0,0,12,0"/>
                            <Border Width="14" Height="14" Background="#2C2C2C" BorderBrush="#6B7280" BorderThickness="1" Margin="0,0,4,0"/>
                            <TextBlock Text="Nema promjene" Foreground="#D1D5DB"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DockPanel Grid.Row="5" Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock Text="ERP info" Style="{StaticResource SectionTitle}"/>
                    <Button DockPanel.Dock="Right" x:Name="btnIzmjenaErp" Content="Izmjena podataka (ERP)"
                            Style="{StaticResource FButton}" Margin="0" Click="BtnIzmjenaErp_Click"
                            ToolTip="Sačuvaj donju tabelu u ERP"/>
                </DockPanel>

                <DataGrid Grid.Row="6" x:Name="gridErp" RowStyle="{StaticResource StatusRowStyle}"/>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="lblStatus" Foreground="#9CA3AF" FontSize="12" Margin="2,10,0,0"/>
    </Grid>
    </Border>
</Window>
