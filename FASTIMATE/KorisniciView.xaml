<UserControl x:Class="FASTIMATE.KorisniciView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="740"
             Background="Transparent" FontFamily="Segoe UI" FontSize="13"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="RoundedButtonStyleBase" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="105"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25,15,25,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Zaglavlje -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="KORISNICI APLIKACIJE" FontSize="20" FontWeight="Bold" Foreground="#00BCD4"/>
            <TextBlock Text="Pregled, unos i izmjena korisnika. Lozinke se čuvaju hashovane." FontSize="12" Foreground="#AAA" Margin="0,2,0,0"/>
            <Border x:Name="bannerMijenjan" Visibility="Collapsed" Background="#331B1B" BorderBrush="#FF5252" BorderThickness="1"
                    CornerRadius="6" Padding="10,5" Margin="0,6,0,0">
                <TextBlock Foreground="#FF5252" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"
                           Text="Fajl s korisnicima je ručno mijenjan! Prijaviti se može samo ugrađeni admin. Provjerite korisnike; snimanje ili brisanje ponovo potvrđuje fajl."/>
            </Border>
        </StackPanel>

        <!-- Forma za unos / izmjenu (ispod tabele) -->
        <Border Grid.Row="2" Background="#2C2C2C" CornerRadius="10" BorderBrush="#444" BorderThickness="1" Padding="15,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Naslov forme -->
                <TextBlock x:Name="lblFormaNaslov" Grid.Row="0" Grid.ColumnSpan="5" Text="NOVI KORISNIK"
                           FontSize="13" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,6"/>

                <!-- Red 1: korisničko ime, ime, prezime -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                    <TextBlock Text="Korisničko ime:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtUsername" Style="{StaticResource InputStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="Ime:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtIme" Style="{StaticResource InputStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,8">
                    <TextBlock Text="Prezime:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtPrezime" Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Red 2: lozinka, ponovi lozinku, prava -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock x:Name="lblLozinka" Text="Lozinka:" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox x:Name="txtLozinka" Style="{StaticResource PasswordStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Ponovi lozinku:" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox x:Name="txtLozinka2" Style="{StaticResource PasswordStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,16">
                    <CheckBox x:Name="chkAdmin" Content="Administrator" Foreground="#DDD" Margin="0,0,18,0"/>
                    <CheckBox x:Name="chkAktivan" Content="Aktivan" Foreground="#DDD" IsChecked="True"/>
                </StackPanel>

                <!-- Red 3: poruka + dugmad -->
                <Grid Grid.Row="3" Grid.ColumnSpan="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="lblMessage" Grid.Column="0" Text="" FontWeight="Bold" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="NOVI" Background="#455A64" BorderBrush="#607D8B" Margin="0,0,8,0"
                                Style="{StaticResource RoundedButtonStyleBase}" Click="btnNovi_Click"/>
                        <Button Content="SAČUVAJ" Background="#00BCD4" BorderBrush="#00BCD4" Margin="0,0,8,0"
                                Style="{StaticResource RoundedButtonStyleBase}" Click="btnSacuvaj_Click"/>
                        <Button x:Name="btnObrisi" Content="OBRIŠI" Background="#C62828" BorderBrush="#E53935" IsEnabled="False"
                                Style="{StaticResource RoundedButtonStyleBase}" Click="btnObrisi_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Lista korisnika (zauzima ostatak visine) -->
        <Border Grid.Row="1" Background="#2C2C2C" CornerRadius="10" BorderBrush="#444" BorderThickness="1" Padding="8">
            <DataGrid x:Name="gridKorisnici"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="#222" RowBackground="#222" AlternatingRowBackground="#282828"
                      Foreground="#E0E0E0" BorderThickness="0"
                      HorizontalGridLinesBrush="#383838"
                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                      SelectionChanged="gridKorisnici_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Korisnik" Binding="{Binding Username}" Width="*"/>
                    <DataGridTextColumn Header="Ime" Binding="{Binding Ime}" Width="*"/>
                    <DataGridTextColumn Header="Prezime" Binding="{Binding Prezime}" Width="*"/>
                    <DataGridTextColumn Header="Admin" Binding="{Binding AdminText}" Width="70"/>
                    <DataGridTextColumn Header="Aktivan" Binding="{Binding AktivanText}" Width="75"/>
                </DataGrid.Columns>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6,3"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0288D1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
