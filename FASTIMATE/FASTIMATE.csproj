  <!-- Release: obfuskacija FASTIMATE.exe (Obfuscar). Zaštićeni exe zamjenjuje originalni u bin\Release. -->
  <Target Name="ObfuscateRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ObfuscarExe>$(NuGetPackageRoot)obfuscar\2.2.40\tools\Obfuscar.Console.exe</ObfuscarExe>
      <ObfuscarOutDir>$(ProjectDir)obj\Obfuscated\</ObfuscarOutDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(ObfuscarExe)')" Text="Obfuscar nije pronađen: $(ObfuscarExe). Pokrenite NuGet restore." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)ProvjeraObfuskacije.ps1&quot; -Exe &quot;$(ProjectDir)$(IntermediateOutputPath)$(TargetFileName)&quot;" />
    <RemoveDir Directories="$(ObfuscarOutDir)" />
    <Exec Command="&quot;$(ObfuscarExe)&quot; &quot;$(ProjectDir)obfuscar.xml&quot;" WorkingDirectory="$(ProjectDir)" />
    <Copy SourceFiles="$(ObfuscarOutDir)FASTIMATE.exe" DestinationFolder="$(TargetDir)" />
    <Delete Files="$(TargetDir)FASTIMATE.pdb" />
  </Target>
