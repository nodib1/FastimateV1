<Window x:Class="FASTIMATE.IzvozDokumentacijeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FASTIMATE - Izvoz Dokumentacije" Height="420" Width="680"
        Icon="app_icon.ico"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyleBase" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,25,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="25">
            <!-- Naslov -->
            <TextBlock Text="IZVOZ DOKUMENTACIJE" FontSize="20" FontWeight="Bold" Foreground="#2196F3" Margin="0,0,0,20"/>

            <!-- Pripremni direktorij -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Pripremni direktorij (Root projekta)" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" FontSize="13"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="txtPutanja" Height="36" Padding="8,6" Background="#2C2C2C"
                                 Foreground="White" BorderBrush="#444" FontSize="13" TextChanged="txtPutanja_TextChanged"/>
                        <TextBlock x:Name="lblPutanjaPlaceholder" Text="Odaberi lokaciju..." Foreground="#888888" FontSize="13"
                                   FontStyle="Italic" Margin="10,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="1" Content="..." Width="55" Height="36" Margin="10,0,0,0"
                            Background="#4CAF50" Foreground="White" BorderBrush="#4CAF50"
                            Style="{StaticResource RoundedButtonStyleBase}" Click="btnOdabrati_Click"/>
                </Grid>
            </StackPanel>

            <!-- Odabir tipova izvoza -->
            <Border Background="#2C2C2C" CornerRadius="8" Padding="20,15" Margin="0,0,0,25" BorderBrush="#333" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Tipovi dokumenata za izvoz:" FontWeight="Bold" Foreground="#AAA" Margin="0,0,0,12" FontSize="12"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="chkPdf" Content="PDF crteži" IsChecked="True"/>
                        <CheckBox x:Name="chkDxf" Content="DXF fajlovi" IsChecked="True"/>
                        <CheckBox x:Name="chkStep" Content="STEP modeli" IsChecked="True"/>
                        <CheckBox x:Name="chkSve" Content="SVE" IsChecked="True" Checked="chkSve_Checked" Unchecked="chkSve_Unchecked"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Dugme POKRENI IZVOZ -->
            <Button x:Name="btnStartExport" Content="POKRENI IZVOZ" Width="180" Height="45" HorizontalAlignment="Right"
                    Background="#2196F3" Foreground="White" BorderBrush="#2196F3" FontSize="14" FontWeight="Bold"
                    Style="{StaticResource RoundedButtonStyleBase}" Click="btnStartExport_Click"/>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid x:Name="loadingOverlay" Background="#CC1E1E1E" Visibility="Collapsed">
            <Border Background="#2C2C2C" CornerRadius="10" Padding="35,25" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#2196F3" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="280" Height="14" Margin="0,0,0,15" Foreground="#2196F3"/>
                    <TextBlock x:Name="lblLoadingStatus" Text="Izvoz dokumentacije u toku... Molimo sačekajte." Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
